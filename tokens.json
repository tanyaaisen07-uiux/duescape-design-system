      "$description": "Scale 0.98, no colour animation",
      "$value": {
        "duration": "120ms",
        "timingFunction": "ease-out"
      }
    },
    "toggle": {
      "$type": "transition",
      "$description": "Knob travels 20px",
      "$value": {
        "duration": "160ms",
        "timingFunction": "ease-out"
      }
    },
    "screen-push": {
      "$type": "transition",
      "$description": "Back uses the same curve reversed",
      "$value": {
        "duration": "280ms",
        "timingFunction": "ease-out"
      }
    },
    "tab-switch": {
